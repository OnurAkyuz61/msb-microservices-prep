<?xml version="1.0" encoding="UTF-8"?>
<!-- IntelliJ: proje varsayılan inspection profili -->
<component name="InspectionProjectProfileManager">
  <profile version="1.0">
    <!-- Profil adı: Project Default -->
    <option name="myName" value="Project Default" />

    <!--
      SpellCheckingInspection KAPALI:
      Türkçe yorum satırlarındaki kelimeler İngilizce sözlükte "Typo" sanılmasın diye.
      Bu bir eğitim projesi; her satırda Türkçe // açıklama zorunlu.
    -->
    <inspection_tool class="SpellCheckingInspection" enabled="false" level="TYPO" enabled_by_default="false">
      <option name="processCode" value="true" />
      <option name="processLiterals" value="true" />
      <option name="processComments" value="true" />
    </inspection_tool>

    <!--
      System.out / System.err uyarıları KAPALI:
      Bu bir konsol uygulaması; System.out.println kasıtlı kullanılıyor.
      "replaced with a logpoint" önerisi production logger / debugger içindir.
    -->
    <inspection_tool class="SystemOutOrErrWithoutLogging" enabled="false" level="WARNING" enabled_by_default="false" />
  </profile>
</component>
